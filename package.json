{
  "name": "@decdn/client",
  "version": "0.1.1",
  "description": "TypeScript client for deCDN over a decdn gateway: verified fetches, bundles, loopback capabilities and namespace pointers.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decdn/sdk-typescript.git"
  },
  "homepage": "https://github.com/decdn/sdk-typescript#readme",
  "bugs": "https://github.com/decdn/sdk-typescript/issues",
  "keywords": [
    "decdn",
    "cdn",
    "blake3",
    "content-addressed",
    "gateway"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19"
  },
  "decdn": {
    "gatewayFloor": "0.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "types": "./dist/node.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit --project contract",
    "test:coverage": "vitest run --coverage --project unit --project contract",
    "test:contract": "vitest run --project contract",
    "test:browser": "vitest run --project browser",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.4",
    "publint": "^0.3.25",
    "typescript": "^6",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
